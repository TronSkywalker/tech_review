# Leave blank until you onboard projects. No Sentry account is needed to run locally.
# Optional shared DSN; per-service values below take precedence.
# Self-hosted + Docker: use http://<public-key>@sentry/<project-id> with
# compose.local-sentry.yaml. For local Node processes use localhost:9000 instead.
SENTRY_DSN=
SENTRY_ENVIRONMENT=showcase
SENTRY_RELEASE=pokemon-showcase@1.0.0
SENTRY_DSN_ADAPTER=
SENTRY_DSN_PIKACHU=
SENTRY_DSN_BULBASAUR=
SENTRY_DSN_CHARMANDER=
SENTRY_DSN_SQUIRTLE=
SENTRY_DSN_EEVEE=
SENTRY_DSN_JIGGLYPUFF=
SENTRY_DSN_MEOWTH=
SENTRY_DSN_PSYDUCK=
SENTRY_DSN_SNORLAX=
SENTRY_DSN_GENGAR=
